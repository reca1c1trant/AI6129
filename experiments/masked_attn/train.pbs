#!/bin/bash
#PBS -N masked_attn
#PBS -l select=1:ngpus=1:ncpus=4:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/masked_attn_train.log
#PBS -P personal-song0304
#PBS -q normal

eval "$(/app/apps/miniforge3/25.3.1/condabin/conda shell.bash hook)"
conda activate loraedit

echo "=== Masked Attention Experiment: V7_hair, 100 epochs ==="
echo "=== Background tokens attend to background only ==="
echo "=== Foreground tokens attend to all ==="
echo "=== START: $(date) ==="

cd /home/users/ntu/song0304/code/LoRAEdit

deepspeed --num_gpus 1 \
    /home/users/ntu/song0304/code/experiments/masked_attn/train.py \
    --deepspeed \
    --config /home/users/ntu/song0304/code/experiments/masked_attn/config.toml

echo "=== END: $(date) ==="
