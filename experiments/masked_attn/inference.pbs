#!/bin/bash
#PBS -N masked_attn_inf
#PBS -l select=1:ngpus=1:ncpus=4:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/masked_attn_inference.log
#PBS -P personal-song0304
#PBS -q normal

eval "$(/app/apps/miniforge3/25.3.1/condabin/conda shell.bash hook)"
conda activate loraedit

echo "=== Masked Attention Inference ==="
echo "=== START: $(date) ==="

DATA_DIR="/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_hair"
MASKED_ATTN_LORA="/scratch/users/ntu/song0304/loraedit_exp/experiments/masked_attn/lora/20260321_15-58-09"
SYMLINK_PATH="${DATA_DIR}/lora/zzz_masked_attn"
OUT_DIR="/scratch/users/ntu/song0304/loraedit_exp/experiments/masked_attn/results"

mkdir -p "${OUT_DIR}"
cd /home/users/ntu/song0304/code/LoRAEdit

# === Step 1: Inference with masked_attn LoRA (epoch 100) ===
echo "=== Creating symlink for masked_attn LoRA ==="
ln -sf "${MASKED_ATTN_LORA}" "${SYMLINK_PATH}"

echo "=== Running inference (--compare: original + edited) ==="
python inference_lowmem.py \
    --model_root_dir /scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P \
    --data_dir "${DATA_DIR}" \
    --epoch 100 \
    --compare \
    --output_name comparison_masked_attn_ep100.mp4 \
    --prompt "A woman with long hair"

echo "=== Removing symlink ==="
rm -f "${SYMLINK_PATH}"

# === Step 2: Create GT video from source frames ===
echo "=== Creating GT video from source_frames ==="
GT_VIDEO="${OUT_DIR}/gt.mp4"
ffmpeg -y -framerate 25 \
    -i "${DATA_DIR}/source_frames/%05d.png" \
    -c:v libx264 -pix_fmt yuv420p -crf 18 \
    "${GT_VIDEO}"

# === Step 3: Create Comparison 1 — GT (left) vs Original (right) ===
echo "=== Creating comparison: GT vs Original ==="
ORIGINAL="${DATA_DIR}/output_original_masked_attn_ep100.mp4"
ffmpeg -y \
    -i "${GT_VIDEO}" \
    -i "${ORIGINAL}" \
    -filter_complex "[0:v]drawtext=text='GT':fontsize=36:fontcolor=white:x=20:y=20[left];[1:v]drawtext=text='Original (MaskedAttn ep100)':fontsize=36:fontcolor=white:x=20:y=20[right];[left][right]hstack=inputs=2" \
    -c:v libx264 -pix_fmt yuv420p -crf 18 \
    "${OUT_DIR}/comparison_gt_vs_original.mp4"

# === Step 4: Create Comparison 2 — Original (left) vs Edited (right) ===
echo "=== Creating comparison: Original vs Edited ==="
EDITED="${DATA_DIR}/output_edited_masked_attn_ep100.mp4"
ffmpeg -y \
    -i "${ORIGINAL}" \
    -i "${EDITED}" \
    -filter_complex "[0:v]drawtext=text='Original':fontsize=36:fontcolor=white:x=20:y=20[left];[1:v]drawtext=text='Edited (MaskedAttn ep100)':fontsize=36:fontcolor=white:x=20:y=20[right];[left][right]hstack=inputs=2" \
    -c:v libx264 -pix_fmt yuv420p -crf 18 \
    "${OUT_DIR}/comparison_original_vs_edited.mp4"

# === Step 5: Background MSE comparison ===
echo ""
echo "=== Background MSE: Masked Attention vs Baseline (Run4) ==="
python /home/users/ntu/song0304/code/experiments/masked_attn/compare_bg_mse.py \
    --data_dir "${DATA_DIR}" \
    --videos \
        output_original_run4_ep100.mp4 \
        output_original_masked_attn_ep100.mp4 \
    --region both

echo ""
echo "=== Output files ==="
echo "  Comparison 1 (GT vs Original): ${OUT_DIR}/comparison_gt_vs_original.mp4"
echo "  Comparison 2 (Original vs Edited): ${OUT_DIR}/comparison_original_vs_edited.mp4"
echo "  Raw original: ${DATA_DIR}/output_original_masked_attn_ep100.mp4"
echo "  Raw edited: ${DATA_DIR}/output_edited_masked_attn_ep100.mp4"
echo "=== END: $(date) ==="
