#!/bin/bash
#PBS -N ear_stage2
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/train_earring_stage2.log
#PBS -P personal-song0304
#PBS -q normal

eval "$(/app/apps/miniforge3/25.3.1/condabin/conda shell.bash hook)"
conda activate loraedit

echo "=== Earring Stage 2: Reference Frame Training ==="
echo "=== Paper 3.3.2: init from Stage 1 ep100, train 100 epochs ==="
echo "=== Reference frame: edited frame 40 (Gemini-generated earring) ==="
echo "=== START: $(date) ==="

cd /home/users/ntu/song0304/code/LoRAEdit

deepspeed --num_gpus 1 train.py \
    --deepspeed \
    --config /scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring_stage2/configs/training.toml

echo "=== TRAINING COMPLETE ==="
echo "=== END: $(date) ==="
