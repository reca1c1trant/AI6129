#!/bin/bash
#PBS -N compare_gt
#PBS -l select=1:ncpus=4:mem=16gb
#PBS -l walltime=0:30:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/compare_gt_original.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

DATA_DIR="/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_hair"
FRAMES_DIR="${DATA_DIR}/source_frames"

echo "=== Compare GT vs Generated Original ==="
echo "=== START: $(date) ==="

# Step 1: Create GT video from source frames (832x480, 25fps, 81 frames)
echo ""
echo "--- Creating GT video from source frames ---"
ffmpeg -y -framerate 25 -i "${FRAMES_DIR}/%05d.jpg" \
  -c:v libx264 -pix_fmt yuv420p -crf 18 \
  "${DATA_DIR}/gt_video.mp4"
echo "Saved: gt_video.mp4"

# Step 2: Create side-by-side comparison for each epoch (GT left | Generated right)
for EPOCH in 50 100 150 200; do
  ORIG="${DATA_DIR}/output_original_run4_ep${EPOCH}.mp4"
  OUT="${DATA_DIR}/gt_vs_original_run4_ep${EPOCH}.mp4"

  if [ ! -f "${ORIG}" ]; then
    echo "WARNING: ${ORIG} not found, skipping epoch ${EPOCH}"
    continue
  fi

  echo ""
  echo "--- Epoch ${EPOCH}: GT (left) vs Generated Original (right) ---"
  ffmpeg -y -i "${DATA_DIR}/gt_video.mp4" -i "${ORIG}" \
    -filter_complex "[0:v][1:v]hstack=inputs=2[out]" \
    -map "[out]" -c:v libx264 -pix_fmt yuv420p -crf 18 \
    "${OUT}"
  echo "Saved: gt_vs_original_run4_ep${EPOCH}.mp4"
done

echo ""
echo "=== Output files ==="
ls -lh "${DATA_DIR}"/gt_vs_original_run4_ep*.mp4 2>/dev/null
ls -lh "${DATA_DIR}"/gt_video.mp4 2>/dev/null

echo ""
echo "=== DONE: $(date) ==="
