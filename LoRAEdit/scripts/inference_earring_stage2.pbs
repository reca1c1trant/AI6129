#!/bin/bash
#PBS -N ear_s2_inf
#PBS -l select=1:ngpus=1:ncpus=4:mem=64gb
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/inference_earring_stage2.log
#PBS -P personal-song0304
#PBS -q normal

eval "$(/app/apps/miniforge3/25.3.1/condabin/conda shell.bash hook)"
conda activate loraedit

echo "=== Earring Stage 2 Inference + Comparison ==="
echo "=== Paper 3.3.2: Reference frame at frame 40 ==="
echo "=== START: $(date) ==="

DATA_DIR="/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring_stage2"
OUT_DIR="/scratch/users/ntu/song0304/loraedit_exp/experiments/earring_stage2/results"
mkdir -p "${OUT_DIR}"

cd /home/users/ntu/song0304/code/LoRAEdit

# === Step 1: Inference for ep50 and ep100 ===
for EPOCH in 50 100; do
    echo ""
    echo "=== Inference: Stage 2, epoch ${EPOCH} ==="
    python inference_lowmem.py \
        --model_root_dir /scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P \
        --data_dir "${DATA_DIR}" \
        --epoch ${EPOCH} \
        --compare \
        --output_name "stage2_ep${EPOCH}" \
        --prompt "a video scene"
done

# === Step 2: Create GT video ===
echo ""
echo "=== Creating GT video ==="
GT_VIDEO="${OUT_DIR}/gt.mp4"
ffmpeg -y -framerate 25 \
    -i "${DATA_DIR}/source_frames/%05d.jpg" \
    -c:v libx264 -pix_fmt yuv420p -crf 18 \
    "${GT_VIDEO}"

# === Step 3: Comparison videos ===
for EPOCH in 50 100; do
    ORIGINAL="${DATA_DIR}/output_original_stage2_ep${EPOCH}.mp4"
    EDITED="${DATA_DIR}/output_edited_stage2_ep${EPOCH}.mp4"

    if [ ! -f "${ORIGINAL}" ] || [ ! -f "${EDITED}" ]; then
        echo "Skipping comparison for epoch ${EPOCH}: output files not found"
        continue
    fi

    echo ""
    echo "=== Comparison: GT vs Original (Stage2 ep${EPOCH}) ==="
    ffmpeg -y \
        -i "${GT_VIDEO}" \
        -i "${ORIGINAL}" \
        -filter_complex "[0:v]drawtext=text='GT':fontsize=36:fontcolor=white:x=20:y=20[left];[1:v]drawtext=text='Original (Stage2 ep${EPOCH})':fontsize=36:fontcolor=white:x=20:y=20[right];[left][right]hstack=inputs=2" \
        -c:v libx264 -pix_fmt yuv420p -crf 18 \
        "${OUT_DIR}/comparison_gt_vs_original_ep${EPOCH}.mp4"

    echo "=== Comparison: Original vs Edited (Stage2 ep${EPOCH}) ==="
    ffmpeg -y \
        -i "${ORIGINAL}" \
        -i "${EDITED}" \
        -filter_complex "[0:v]drawtext=text='Original':fontsize=36:fontcolor=white:x=20:y=20[left];[1:v]drawtext=text='Edited (Stage2 ep${EPOCH})':fontsize=36:fontcolor=white:x=20:y=20[right];[left][right]hstack=inputs=2" \
        -c:v libx264 -pix_fmt yuv420p -crf 18 \
        "${OUT_DIR}/comparison_original_vs_edited_ep${EPOCH}.mp4"
done

echo ""
echo "=== Output files ==="
ls -lh "${OUT_DIR}/"
ls -lh "${DATA_DIR}/output_"*.mp4 2>/dev/null
echo "=== END: $(date) ==="
