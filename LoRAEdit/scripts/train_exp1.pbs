#!/bin/bash
#PBS -N loraedit_exp1
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=02:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/exp1_train.log

# === Environment ===
cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

# === Create log dir ===
mkdir -p /scratch/users/ntu/song0304/loraedit_exp/logs

# === Training (4 GPU pipeline parallelism) ===
NCCL_P2P_DISABLE="1" NCCL_IB_DISABLE="1" \
deepspeed --num_gpus=1 train.py \
  --deepspeed \
  --config /scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_baseline/configs/training.toml

echo "Training done at $(date)"
