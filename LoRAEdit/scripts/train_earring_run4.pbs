#!/bin/bash
#PBS -N earring_run4
#PBS -l select=1:ngpus=1:ncpus=4:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/train_earring_run4.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

echo "=== Run4: earring, lr=0.0005, cosine annealing to 1e-6, 200 epochs ==="
echo "=== blocks_to_swap=24, transformer_dtype=bfloat16 ==="
echo "=== START: $(date) ==="

deepspeed --num_gpus 1 train.py --deepspeed \
    --config /scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring/configs/training.toml

echo "=== END: $(date) ==="
