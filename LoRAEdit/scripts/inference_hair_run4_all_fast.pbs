#!/bin/bash
#PBS -N infer_r4_fast
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/inference_hair_run4_fast.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

echo "=== Run4 inference (optimized): GPU DiT load + persistent params ==="
echo "=== START: $(date) ==="

MODEL_DIR=/scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P
DATA_DIR=/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_hair

for EP in 50 100 150 200; do
  echo ""
  echo "========== Hair epoch${EP} =========="
  echo "Start: $(date)"
  python inference_lowmem.py \
    --model_root_dir "${MODEL_DIR}" \
    --data_dir "${DATA_DIR}" \
    --prompt "a video scene" \
    --compare \
    --num_persistent_params 10000000000 \
    --epoch ${EP} \
    --output_name comparison_run4_ep${EP}.mp4
  echo "epoch${EP} done at $(date)"
done

echo ""
echo "=== All done at $(date) ==="
