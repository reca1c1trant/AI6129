#!/bin/bash
#PBS -N infer_ear_r3all
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=12:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/inference_earring_run3_all.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

for EP in 50 100 150 200; do
  echo "========== Earring epoch${EP} =========="
  python inference_lowmem.py \
    --model_root_dir /scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P \
    --data_dir /scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring \
    --prompt "a video scene" \
    --epoch ${EP} \
    --compare \
    --output_name comparison_run3_ep${EP}.mp4
  echo "epoch${EP} done at $(date)"
done

echo "All done at $(date)"
