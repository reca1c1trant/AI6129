#!/bin/bash
#PBS -N test_bf16
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=01:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/test_bf16_speed.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

# Create temp config: 3 epochs, no saving, no eval
python -c "
import toml
config = toml.load('/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_hair/configs/training.toml')
config['epochs'] = 3
config['save_every_n_epochs'] = 1000000
config['eval_before_first_step'] = False
config['output_dir'] = '/tmp/test_bf16_lora'
with open('/tmp/test_bf16_speed.toml', 'w') as f:
    toml.dump(config, f)
print('Config written. Key settings:')
print(f'  transformer_dtype: {config[\"model\"][\"transformer_dtype\"]}')
print(f'  blocks_to_swap: {config[\"blocks_to_swap\"]}')
"

echo "=== START: $(date) ==="

# Monitor GPU memory in background
nvidia-smi --query-gpu=timestamp,memory.used,memory.total --format=csv -l 5 > /tmp/gpu_mem_log.csv &
NVPID=$!

time NCCL_P2P_DISABLE="1" NCCL_IB_DISABLE="1" \
deepspeed --num_gpus=1 train.py \
  --deepspeed \
  --config /tmp/test_bf16_speed.toml

kill $NVPID 2>/dev/null

echo ""
echo "=== GPU Memory Usage ==="
cat /tmp/gpu_mem_log.csv

echo ""
echo "=== DONE: $(date) ==="
