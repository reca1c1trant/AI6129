#!/bin/bash
#PBS -N infer_ear_orig
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=06:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/inference_earring_original.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

DATA_DIR=/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring

# 备份编辑帧，用原始帧替代
cp "$DATA_DIR/edited_image.png" "$DATA_DIR/edited_image_backup.png"
cp "$DATA_DIR/source_frames/00000.png" "$DATA_DIR/edited_image.png"

python inference_lowmem.py \
  --model_root_dir /scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P \
  --data_dir "$DATA_DIR" \
  --prompt "a video scene" \
  --output_name "output_original.mp4"

# 恢复编辑帧
mv "$DATA_DIR/edited_image_backup.png" "$DATA_DIR/edited_image.png"

echo "Inference (original frame) done at $(date)"
