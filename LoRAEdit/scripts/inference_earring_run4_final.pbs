#!/bin/bash
#PBS -N infer_ear_r4
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=4:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/inference_earring_run4_final.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
eval "$(/app/apps/miniforge3/25.3.1/condabin/conda shell.bash hook)"
conda activate loraedit

echo "=== Run4 earring inference: batch + native LoRA ==="
echo "=== START: $(date) ==="

python inference_batch.py \
  --model_root_dir /scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P \
  --data_dir /scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring \
  --epochs 50,100,150,200 \
  --prompt "a video scene" \
  --compare

echo ""
echo "=== DONE: $(date) ==="
