#!/bin/bash
#PBS -N ear_exp_train
#PBS -l select=1:ngpus=1:ncpus=8:mem=64gb
#PBS -l walltime=04:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/train_earring_expanded.log
#PBS -P personal-song0304
#PBS -q normal

eval "$(/app/apps/miniforge3/25.3.1/condabin/conda shell.bash hook)"
conda activate loraedit

echo "=== Earring Expanded Mask Training ==="
echo "=== Mask expanded +33% downward, 200 epochs ==="
echo "=== START: $(date) ==="

cd /home/users/ntu/song0304/code/LoRAEdit

deepspeed --num_gpus 1 train.py \
    --deepspeed \
    --config /scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_earring_expanded/configs/training.toml

echo "=== TRAINING COMPLETE ==="
echo "=== END: $(date) ==="
