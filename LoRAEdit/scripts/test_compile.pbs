#!/bin/bash
#PBS -N test_compile
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1
#PBS -l walltime=2:00:00
#PBS -j oe
#PBS -o /scratch/users/ntu/song0304/loraedit_exp/logs/test_compile.log
#PBS -P personal-song0304
#PBS -q normal

cd /home/users/ntu/song0304/code/LoRAEdit
source activate loraedit

MODEL_DIR=/scratch/users/ntu/song0304/checkpoints/Wan2.1-I2V-14B-480P
DATA_DIR=/scratch/users/ntu/song0304/loraedit_exp/processed_data/V7_hair

echo "=== A/B test: torch.compile on DiT ==="
echo "=== START: $(date) ==="

echo ""
echo "============================================"
echo "  Run 1: baseline (no compile, single infer)"
echo "============================================"
python inference_batch.py \
  --model_root_dir "${MODEL_DIR}" \
  --data_dir "${DATA_DIR}" \
  --epochs 50 \
  --prompt "a video scene" \
  --num_persistent_params 10000000000

echo ""
echo "============================================"
echo "  Run 2: torch.compile (single infer)"
echo "============================================"
python inference_batch.py \
  --model_root_dir "${MODEL_DIR}" \
  --data_dir "${DATA_DIR}" \
  --epochs 50 \
  --prompt "a video scene" \
  --num_persistent_params 10000000000 \
  --compile

echo ""
echo "=== DONE: $(date) ==="
